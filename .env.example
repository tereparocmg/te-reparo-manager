# ============================================================
# Te Reparo — variables de entorno (copiar a .env)
# ============================================================

# Base de datos (PostgreSQL en desarrollo y producción):
#  · Desarrollo: PostgreSQL embebido sin root (bun run db:init lo arranca
#    en localhost:5432 — ver scripts/pg.ts)
#  · Producción: proveedor gestionado (Railway, RDS, etc.)
DATABASE_URL="postgresql://tereparo@localhost:5432/tereparo?schema=public"
# DATABASE_URL="postgresql://usuario:contrasena@servidor:5432/te_reparo?schema=public"

# Secreto para firmar el JWT de sesión (cookie httpOnly).
# Generar uno largo y aleatorio:  openssl rand -hex 32
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Zona horaria del servidor: define el corte del "día" de liquidación
# y las fechas que se muestran (los talleres operan en Cuba).
TZ="America/Havana"
