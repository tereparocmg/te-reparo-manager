# ============================================================
# Te Reparo Manager — Environment Variables
# ============================================================
# Aplicación web 100% online (PostgreSQL en Railway / Supabase / Neon / etc.)
# ============================================================

# URL de conexión a PostgreSQL (Railway la inyecta automáticamente al agregar el plugin).
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/tereparo?schema=public

# Secreto para firmar cookies de sesión (cámbialo en producción)
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Entorno de Node
NODE_ENV=development

# Puerto (Railway lo inyecta automáticamente; por defecto 3000)
PORT=3000
